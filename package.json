{
  "name": "TailBliss",
  "version": "0.6.1",
  "description": "Hugo + Alpine.js + TailwindCSS",
  "main": "index.js",
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.15.12",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.11"
  },
  "scripts": {
    "start": "concurrently npm:watch:*",
    "watch:tw": "postcss ./assets/css/main.css -o ./assets/css/style.css --watch",
    "watch:hugo": "hugo server",
    "build:tw": "postcss ./assets/css/main.css -o ./assets/css/style.css",
    "build": "npm run build:tw && hugo --minify",
    "prepare": "husky",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nusserstudios/tailbliss.git"
  },
  "keywords": [
    "hugo",
    "tailwind",
    "tailwindcss",
    "alpinejs",
    "minimal",
    "responsive",
    "light mode",
    "dark mode",
    "hugo blog",
    "categories",
    "tags"
  ],
  "author": "NusserStudios",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nusserstudios/tailbliss/issues"
  },
  "homepage": "https://github.com/nusserstudios/tailbliss"
}
