{
  "name": "TailBliss",
  "version": "0.6.1",
  "description": "Hugo + Alpine.js + TailwindCSS",
  "main": "index.js",
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.157",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "copy:alpine": "mkdir -p assets/js && cp node_modules/alpinejs/dist/cdn.min.js assets/js/alpine.min.js",
    "start": "pnpm run copy:alpine && concurrently \"pnpm run watch:tw\" \"pnpm run watch:hugo\"",
    "watch:tw": "postcss ./assets/css/main.css -o ./assets/css/style.css --watch",
    "watch:hugo": "hugo server",
    "build:tw": "postcss ./assets/css/main.css -o ./assets/css/style.css",
    "build": "pnpm run copy:alpine && pnpm run build:tw && hugo --minify",
    "prepare": "husky",
    "test": "node scripts/clear-hugo-lock.mjs && node --test --test-concurrency=1",
    "posttest": "node scripts/clear-hugo-lock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nusserstudios/tailbliss.git"
  },
  "keywords": [
    "hugo",
    "tailwind",
    "tailwindcss",
    "alpinejs",
    "minimal",
    "responsive",
    "light mode",
    "dark mode",
    "hugo blog",
    "categories",
    "tags"
  ],
  "author": "NusserStudios",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nusserstudios/tailbliss/issues"
  },
  "homepage": "https://github.com/nusserstudios/tailbliss",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
